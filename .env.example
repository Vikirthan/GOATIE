# GOATIE environment template.
# Copy to `.env` for local dev. NEVER commit real values.
#
# Two groups: APP (VITE_ → bundled into the public JS, safe values only) and
# SERVER (plain names → Vercel env only, never VITE_-prefixed, never in git).

# ── APP: Supabase (required) ──────────────────────────────────────────────
# The anon key is public by design — RLS policies enforce per-herd access,
# so a stranger's key entitles zero rows.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── SERVER: Supabase admin (required) ─────────────────────────────────────
# Set in Vercel → Project → Settings → Environment Variables (Production AND
# Preview scopes — preview deploys need these too or /api/* fails).
# Powers /api/master-sync and /api/admin/* (user create/reset/ban).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── SERVER: Master Sheet sync (required for Recon / Verify / Restore) ─────
# Apps Script Web App (/exec URL, deployed as Me with Anyone access) + secret.
# The browser calls same-origin /api/master-sync; only that route holds these.
GOOGLE_SHEETS_BACKUP_WEBAPP_URL=your_apps_script_webapp_exec_url
GOOGLE_SHEETS_BACKUP_SECRET=your_apps_script_secret

# ── SERVER: app URL (recommended) ─────────────────────────────────────────
# Where password-recovery emails redirect. Falls back to the Supabase Auth
# settings URL when unset. Set the production URL in Vercel.
# SITE_URL=https://your-app.vercel.app

# ── SERVER: closed-app cron (required — vercel.json schedules it) ───────────
# Vercel sends this as the bearer token when it invokes the scheduled job
# (GET /api/master-sync?run=1, daily 19:30 UTC = 01:00 IST). Use any long random string.
CRON_SECRET=your_random_cron_secret

# ── SERVER: ops flags (optional) ───────────────────────────────────────────
# Force the monthly full sheet rewrite on any day (default: 1st of month).
# FORCE_FULL_REWRITE=1
