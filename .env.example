# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# App Config
VITE_APP_NAME=GOATIE
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Professional Goat Farm Management System

# ── Weekly Sheets Backup/Recon (api/recon-sheets.ts) ──────────────────────────
# Set these in the Vercel project's Environment Variables. Only needed locally
# if testing the route with `vercel dev`. See google-apps-script/backup-recon/README.md.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GOOGLE_SHEETS_BACKUP_WEBAPP_URL=your_apps_script_webapp_exec_url
CRON_SECRET=your_random_cron_secret
